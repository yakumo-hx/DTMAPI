    <None Include="..\..\..\..\.tools\bepinex\extract\BepInEx\core\Mono.Cecil.dll" Link="Mono.Cecil.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\..\.tools\bepinex\extract\BepInEx\core\Mono.Cecil.Mdb.dll" Link="Mono.Cecil.Mdb.dll" CopyToOutputDirectory="PreserveNewest" />
