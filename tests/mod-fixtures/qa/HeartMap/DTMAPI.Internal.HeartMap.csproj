<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <DtmApiReferences Condition="'$(DtmApiReferences)' == ''">$(MSBuildThisFileDirectory)../../../../.tools/api-references</DtmApiReferences>
    <DtmApiNativeReferencePaths>DolocTown_Data/Managed/Assembly-CSharp.dll;DolocTown_Data/Managed/Assembly-CSharp-firstpass.dll;DolocTown_Data/Managed/UnityEngine.CoreModule.dll;DolocTown_Data/Managed/UnityEngine.GridModule.dll;DolocTown_Data/Managed/UnityEngine.TilemapModule.dll;DolocTown_Data/Managed/UnityEngine.Physics2DModule.dll;DolocTown_Data/Managed/UnityEngine.TextRenderingModule.dll;DolocTown_Data/Managed/UnityEngine.ScreenCaptureModule.dll;BepInEx/core/0Harmony.dll;DolocTown_Data/Managed/UnityEngine.IMGUIModule.dll;DolocTown_Data/Managed/Unity.InputSystem.dll</DtmApiNativeReferencePaths>
  </PropertyGroup>
  <PropertyGroup>
    <AssemblyName>DTMAPI.Internal.HeartMap</AssemblyName>
    <RootNamespace>DTMAPI.Internal.HeartMap</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../src/DTMAPI.MapData/DTMAPI.MapData.csproj" DtmApiRole="private-managed" DtmApiDistribution="self-authored" />
    <EmbeddedResource Include="content/Maps/*.dtmap.json" LogicalName="Maps.%(Filename)%(Extension)" />
    <None Remove="content/**/*" />
    <Content Include="content/**/*" DtmApiPackagePath="Content/DTMAPI/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="DTMAPI.Abstractions" HintPath="$(DtmApiReferences)/DTMAPI.Abstractions.dll" Private="false" />
    <Reference Include="DTMAPI.ModConfigMenu" HintPath="$(DtmApiReferences)/DTMAPI.ModConfigMenu.dll" Private="false" />
    <Reference Include="DTMAPI.MonsterContent" HintPath="$(DtmApiReferences)/DTMAPI.MonsterContent.dll" Private="false" />
    <Reference Include="DTMAPI.AudioContent" HintPath="$(DtmApiReferences)/DTMAPI.AudioContent.dll" Private="false" />
    <Reference Include="$(DtmApiNativeReferences)/*.dll" Condition="'$(DtmApiNativeReferences)' != ''" Private="false" />
  </ItemGroup>
</Project>
