<Project Sdk="Microsoft.NET.Sdk" DefaultTargets="Collect">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <DtmApiAllowMissing Condition="'$(DtmApiAllowMissing)' == ''">false</DtmApiAllowMissing>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="BuildInputs.cs" />
    <Reference Include="Microsoft.Build" HintPath="$(MSBuildToolsPath)/Microsoft.Build.dll" Private="false" />
    <Reference Include="Microsoft.Build.Framework" HintPath="$(MSBuildToolsPath)/Microsoft.Build.Framework.dll" Private="false" />
    <Reference Include="Microsoft.Build.Utilities.Core" HintPath="$(MSBuildToolsPath)/Microsoft.Build.Utilities.Core.dll" Private="false" />
  </ItemGroup>
  <UsingTask TaskName="DtmApiBuildInputs" AssemblyFile="$(TargetPath)" />
  <Target Name="Collect" DependsOnTargets="Build">
    <ReadLinesFromFile File="$(DtmApiProjectsFile)"><Output TaskParameter="Lines" ItemName="Projects" /></ReadLinesFromFile>
    <DtmApiBuildInputs Projects="@(Projects)" Configuration="$(Configuration)" OutputFile="$(DtmApiIdentityFile)" PathsFile="$(DtmApiPathsFile)" AllowMissing="$(DtmApiAllowMissing)" ChangedPathsFile="$(DtmApiChangedPathsFile)" />
  </Target>
</Project>
