        "src/DTMAPI.BepInExStubs",
        "src/DTMAPI.Core",
        "src/DTMAPI.GameBridge.DolocTown",
        "src/DTMAPI.GameBridge.DolocTown.Compatibility",
        "src/DTMAPI.GameBridge.DolocTown.QA",
        "src/DTMAPI.InstallDoctor",
        "src/DTMAPI.ModConfigMenu",
        "src/DTMAPI.MultiPlatformInstaller",
        "src/DTMAPI.PlayerDoctor",
        "src/DTMAPI.Tooling.Metadata",
        "src/DTMAPI.NativeReferences",
        "src/Shared",
        "src/DTMAPI.RuntimeModules",
        "src/DTMAPI.AnimalContent",
        "src/DTMAPI.Modules.Animals",
