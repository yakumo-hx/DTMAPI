        ".csproj",
        ".props",
        ".targets",
        ".json",
        ".resx"
      ],
      "reason": "Current implementation and MSBuild-linked shared code; documentation must pass public-link review.",
      "excludedExtensions": [
        ".md",
        ".rst",
        ".adoc",
        ".pdf",
        ".docx",
        ".txt"
      ]
    },
    {
