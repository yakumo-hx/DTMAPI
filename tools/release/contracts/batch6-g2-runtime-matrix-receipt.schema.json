      "properties": {
        "prepareSuccess": { "$ref": "#/$defs/nullableBoolean" },
        "sessionId": { "$ref": "#/$defs/nullableString" },
        "deploymentStatusV1Success": { "$ref": "#/$defs/nullableBoolean" },
        "deploymentStatusV1RecoveryArtifacts": {
          "oneOf": [
            { "const": 0 },
            { "type": "null" }
          ]
