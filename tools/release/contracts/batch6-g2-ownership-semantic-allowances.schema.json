{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtmapi.local/contracts/batch6-g2-ownership-semantic-allowances.schema.json",
  "title": "DTMAPI Batch 6 G2 mandatory Runtime source and build-input ownership semantic allowances",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "schemaPath",
    "architectureAuthority",
    "reviewAuthority",
    "baselineCommit",
    "implementationCommit",
    "allowances"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractId": { "const": "batch6-g2-advanced-synthetic-vertical-slice" },
    "schemaPath": { "const": "tools/release/contracts/batch6-g2-ownership-semantic-allowances.schema.json" },
    "architectureAuthority": { "const": "docs/architecture/batch6-managed-mod-identity-contract.md" },
    "reviewAuthority": { "const": "docs/reviews/code/2026/20260720-0004-batch6-g2-advanced-synthetic-vertical-slice-prerequisite.md" },
    "baselineCommit": { "$ref": "#/$defs/gitCommit" },
    "implementationCommit": { "$ref": "#/$defs/gitCommit" },
    "allowances": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/allowance" }
    }
  },
  "$defs": {
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "gitBlob": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    },
    "allowance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "classification",
        "review",
        "reason",
        "expectedTargetBlob",
        "expectedDiffSha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*\\.(cs|csproj)$"
        },
        "classification": {
          "enum": ["Platform", "SharedNative", "ProductNative", "StableAbstractions"]
        },
        "review": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "expectedTargetBlob": { "$ref": "#/$defs/gitBlob" },
        "expectedDiffSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
