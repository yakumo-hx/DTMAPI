{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DTMAPI generated native provenance V1 / V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ownerId",
    "apiTarget",
    "targetFramework",
    "manifestSha256",
    "entrySha256",
    "dependencyInventorySha256",
    "gameBuild",
    "references",
    "requiredMembers",
    "harmonyOwner",
    "referenceGeneration"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "ownerId": {
      "type": "string"
    },
    "apiTarget": {
      "type": "string"
    },
    "targetFramework": {
      "const": "netstandard2.0"
    },
    "manifestSha256": {
      "$ref": "#/$defs/hash"
    },
    "entrySha256": {
      "$ref": "#/$defs/hash"
    },
    "dependencyInventorySha256": {
      "$ref": "#/$defs/hash"
    },
    "gameBuild": {
      "type": "string"
    },
    "harmonyOwner": {
      "type": "string",
      "minLength": 1
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gameRelativePath",
          "assemblyIdentity",
          "length",
          "sha256",
          "mode",
          "surfaceSha256"
        ],
        "properties": {
          "gameRelativePath": {
            "type": "string",
            "pattern": "^(DolocTown_Data/Managed/|BepInEx/core/).+\\.dll$"
          },
          "assemblyIdentity": {
            "type": "string"
          },
          "length": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "$ref": "#/$defs/hash"
          },
          "mode": {
            "enum": [
              "direct",
              "metadata-surface"
            ]
          },
          "surfaceSha256": {
            "type": "string",
            "pattern": "^([a-f0-9]{64})?$"
          }
        }
      }
    },
    "requiredMembers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/member"
          },
          {
            "$ref": "#/$defs/genericUse"
          }
        ]
      }
    },
    "referenceGeneration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toolVersion",
        "mode",
        "inputSha256",
        "metadataDependencies"
      ],
      "properties": {
        "toolVersion": {
          "const": "0.6.4"
        },
        "mode": {
          "const": "metadata-surface-v1/cecil-0.11.6"
        },
        "inputSha256": {
          "$ref": "#/$defs/hash"
        },
        "metadataDependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gameRelativePath",
              "assemblyIdentity",
              "length",
              "sha256"
            ],
            "properties": {
              "gameRelativePath": {
                "type": "string"
              },
              "assemblyIdentity": {
                "type": "string"
              },
              "length": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "$ref": "#/$defs/hash"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assemblyIdentity",
        "declaringType",
        "kind",
        "name",
        "isStatic",
        "returnType",
        "parameterTypes"
      ],
      "properties": {
        "assemblyIdentity": {
          "type": "string"
        },
        "declaringType": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "type",
            "method",
            "field"
          ]
        },
        "name": {
          "type": "string"
        },
        "isStatic": {
          "type": "boolean"
        },
        "returnType": {
          "type": "string"
        },
        "parameterTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "namedType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "assemblyIdentity",
        "arity"
      ],
      "properties": {
        "kind": {
          "const": "named"
        },
        "name": {
          "type": "string",
          "maxLength": 2048
        },
        "assemblyIdentity": {
          "type": "string",
          "maxLength": 2048
        },
        "arity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        }
      }
    },
    "typeNode": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name",
            "assemblyIdentity",
            "arity"
          ],
          "properties": {
            "kind": {
              "const": "named"
            },
            "name": {
              "type": "string",
              "maxLength": 2048
            },
            "assemblyIdentity": {
              "type": "string",
              "maxLength": 2048
            },
            "arity": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "position"
          ],
          "properties": {
            "kind": {
              "enum": [
                "typeParameter",
                "methodParameter"
              ]
            },
            "position": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "definition",
            "arguments"
          ],
          "properties": {
            "kind": {
              "const": "constructed"
            },
            "definition": {
              "$ref": "#/$defs/namedType"
            },
            "arguments": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "$ref": "#/$defs/typeNode"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "element"
          ],
          "properties": {
            "kind": {
              "enum": [
                "byRef",
                "pointer"
              ]
            },
            "element": {
              "$ref": "#/$defs/typeNode"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "element",
            "rank",
            "vector"
          ],
          "properties": {
            "kind": {
              "const": "array"
            },
            "element": {
              "$ref": "#/$defs/typeNode"
            },
            "rank": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "vector": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flags",
        "types"
      ],
      "properties": {
        "flags": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "types": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/typeNode"
          }
        }
      }
    },
    "genericDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declaringType",
        "kind",
        "name",
        "isStatic",
        "callingConvention",
        "typeParameters",
        "methodParameters",
        "returnType",
        "parameterTypes"
      ],
      "properties": {
        "declaringType": {
          "$ref": "#/$defs/namedType"
        },
        "kind": {
          "enum": [
            "type",
            "field",
            "method"
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 2048
        },
        "isStatic": {
          "type": "boolean"
        },
        "callingConvention": {
          "const": "default"
        },
        "typeParameters": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/constraint"
          }
        },
        "methodParameters": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/constraint"
          }
        },
        "returnType": {
          "$ref": "#/$defs/typeNode"
        },
        "parameterTypes": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/typeNode"
          }
        }
      }
    },
    "genericUse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition",
        "typeArguments",
        "methodArguments",
        "contextTypeArity",
        "contextMethodArity"
      ],
      "properties": {
        "definition": {
          "$ref": "#/$defs/genericDefinition"
        },
        "typeArguments": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/typeNode"
          }
        },
        "methodArguments": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/typeNode"
          }
        },
        "contextTypeArity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "contextMethodArity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        }
      }
    }
  },
  "$comment": "Generated by SDK. V1 keeps its original interpretation; V2 records structured definitions, constraints and instantiations. Readers additionally enforce selectors, marker/schema agreement, exact host/package identities, actual package type definitions, positions/arity, canonical constraint sets, depth bounds and manifest/entry/dependency binding. No author code executes during preflight.",
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "requiredMembers": {
            "items": {
              "$ref": "#/$defs/member"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 2
          }
        }
      },
      "then": {
        "properties": {
          "requiredMembers": {
            "items": {
              "$ref": "#/$defs/genericUse"
            }
          }
        }
      }
    }
  ]
}
