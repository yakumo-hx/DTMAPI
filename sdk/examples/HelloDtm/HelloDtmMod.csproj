<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <DtmApiSourceProject Condition="'$(DtmApiReferences)' == '' And Exists('$(MSBuildThisFileDirectory)../../../src/DTMAPI.Abstractions/DTMAPI.Abstractions.csproj')">$(MSBuildThisFileDirectory)../../../src/DTMAPI.Abstractions/DTMAPI.Abstractions.csproj</DtmApiSourceProject>
    <DtmApiReferences Condition="'$(DtmApiReferences)' == ''">$(MSBuildThisFileDirectory)../../references</DtmApiReferences>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>HelloDtmMod</AssemblyName>
    <RootNamespace>HelloDtmMod</RootNamespace>
  </PropertyGroup>
  <ItemGroup Condition="'$(DtmApiSourceProject)' == ''">
    <Reference Include="DTMAPI.Abstractions" HintPath="$(DtmApiReferences)/DTMAPI.Abstractions.dll" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(DtmApiSourceProject)' != ''">
    <ProjectReference Include="$(DtmApiSourceProject)" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <None Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="PackageDirectory" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath);manifest.json" DestinationFolder="$(MSBuildProjectDirectory)/package/Content/DTMAPI" />
    <Copy SourceFiles="info.json" DestinationFolder="$(MSBuildProjectDirectory)/package" />
  </Target>
</Project>
