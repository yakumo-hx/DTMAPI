<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>dtmapi-author</AssemblyName>
    <RootNamespace>DTMAPI.AuthorSdk</RootNamespace>
    <Version>0.7.5</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs;GlobalUsings.cs;AssemblyInfo.cs;AuthorApplication.cs;CommandLine.cs;OptionalTools.cs;JsonSupport.cs;PathSafety.cs;OfficialLocalPaths.cs;AuthorStateInfrastructure.cs;SourceStateService.cs;AuthorFileTreeDigest.cs;AudioPrepareCommand.cs;SymbolInspector.cs" />
    <Compile Include="../Shared/AuthorTreeDigest.cs" />
    <Compile Include="../Shared/PackageDocumentFacts.cs" Link="PackageDocumentFacts.cs" />
    <ProjectReference Include="../DTMAPI.Authoring.Contracts/DTMAPI.Authoring.Contracts.csproj" />
    <ProjectReference Include="../DTMAPI.AudioPreparation/DTMAPI.AudioPreparation.csproj" />
    <Content Include="../../docs/authors/*.md;../../sdk/THIRD-PARTY-NOTICES.md;../../sdk/Enter-DtmApiEnvironment.ps1" Exclude="../../docs/authors/CONTENT-PACKS.md" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../sdk/schemas/manifest.schema.json" Link="schemas/manifest.schema.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../sdk/examples/HelloDtm/*.cs;../../sdk/examples/HelloDtm/*.csproj;../../sdk/examples/HelloDtm/*.json" Link="examples/HelloDtm/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../sdk/examples/ConfigMenu/*.cs;../../sdk/examples/ConfigMenu/*.csproj;../../sdk/examples/ConfigMenu/*.json" Link="examples/ConfigMenu/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/NativeReferenceSurface.cs" Link="NativeReferenceSurface.cs" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <Content Include="../../sdk/licenses/Mono.Cecil-0.11.6-LICENSE.txt" Link="licenses/Mono.Cecil-0.11.6-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
