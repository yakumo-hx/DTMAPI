*.dll
*.exe
*.pdb
*.zip
*.7z
*.rar
*.nupkg

# Official game assembly inputs must remain local reference material only
references/doloc-town/reverse/builds/*/input/

# Copied external runtime/reference installs
references/stardew-smapi/installed/
