<Project>
  <Import Project="../Directory.Build.props" />
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)/info.json')">
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/info.json')), '&quot;version&quot;\s*:\s*&quot;([^&quot;]+)&quot;').Groups[1].Value)</Version>
  </PropertyGroup>
</Project>
