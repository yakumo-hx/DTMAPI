{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtmapi.invalid/schemas/author-sdk/0.1/advanced-reference-policy-registry.schema.json",
  "title": "DTMAPI tracked Advanced CodeMod policy registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policies"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/policy" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "policySha256", "requiredUniqueId", "minimumDtmApiVersion", "compilerSurfaceSha256"],
      "properties": {
        "policyId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
        "policySha256": { "$ref": "#/$defs/sha256" },
        "requiredUniqueId": { "type": "string", "pattern": "^[A-Za-z0-9_]+(?:\\.[A-Za-z0-9_]+)+$" },
        "minimumDtmApiVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "compilerSurfaceSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
