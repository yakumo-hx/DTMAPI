{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtmapi.invalid/schemas/author-sdk/0.1/dtmapi-author.schema.json",
  "title": "DTMAPI Author SDK project metadata",
  "oneOf": [
    {
      "$ref": "#/$defs/schema4"
    }
  ],
  "$defs": {
    "publish": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tags",
        "localizedName",
        "localizedDescription"
      ],
      "properties": {
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "localizedName": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "localizedDescription": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "advanced": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "referencePolicyId",
        "references"
      ],
      "properties": {
        "referencePolicyId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]+$"
        },
        "references": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "0Harmony",
              "Assembly-CSharp"
            ]
          }
        }
      }
    },
    "schema4": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectKind",
        "targetDtmApiVersion"
      ],
      "properties": {
        "schemaVersion": {
          "const": 4
        },
        "projectKind": {
          "enum": [
            "CodeMod",
            "ContentPack"
          ]
        },
        "targetDtmApiVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "projectFile": {
          "type": "string",
          "pattern": "\\.csproj$",
          "description": "Relative path to the standard Mod project. Compile inputs and compiler properties belong in MSBuild."
        },
        "codeModKind": {
          "enum": [
            "Strict",
            "Advanced"
          ]
        },
        "contentDirectory": {
          "type": "string",
          "minLength": 1
        },
        "publish": {
          "$ref": "#/$defs/publish"
        },
        "advanced": {
          "$ref": "#/$defs/advanced"
        },
        "nativeReferences": {
          "additionalProperties": false,
          "properties": {
            "gameRoot": {
              "type": "string",
              "minLength": 1
            },
            "references": {
              "uniqueItems": true,
              "minItems": 1,
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "requiredMembers": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "$ref": "dtmapi-native-build.schema.json#/$defs/member"
                  },
                  {
                    "$ref": "dtmapi-native-build.schema.json#/$defs/genericUse"
                  }
                ]
              }
            },
            "harmonyOwner": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "gameRoot",
            "references",
            "harmonyOwner",
            "requiredMembers"
          ],
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "projectKind": {
                "const": "CodeMod"
              }
            }
          },
          "then": {
            "required": [
              "projectFile"
            ],
            "not": {
              "required": [
                "contentDirectory"
              ]
            }
          },
          "else": {
            "required": [
              "contentDirectory"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "projectFile"
                  ]
                },
                {
                  "required": [
                    "codeModKind"
                  ]
                },
                {
                  "required": [
                    "nativeReferences"
                  ]
                },
                {
                  "required": [
                    "advanced"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
