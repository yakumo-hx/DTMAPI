{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtmapi.invalid/schemas/author-sdk/0.1/source-state.schema.json",
  "title": "DTMAPI Author SDK external source state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "gameRoot",
    "playerReproductionActive",
    "reproductionSnapshotId",
    "selections"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "gameRoot": { "type": "string", "minLength": 1 },
    "playerReproductionActive": { "type": "boolean" },
    "reproductionSnapshotId": { "type": "string", "pattern": "^(?:|[a-f0-9]{32})$" },
    "selections": {
      "type": "array",
      "items": { "$ref": "#/$defs/selection" }
    }
  },
  "$defs": {
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uniqueId", "mode", "sourcePath", "expectedTreeSha256"],
      "properties": {
        "uniqueId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*(?:\\.[A-Za-z0-9][A-Za-z0-9_-]*)+$" },
        "mode": { "enum": ["LocalDevelopment", "WorkshopValidation"] },
        "sourcePath": { "type": "string" },
        "expectedTreeSha256": { "type": "string", "pattern": "^(?:|[A-Fa-f0-9]{64})$" }
      }
    }
  }
}
