{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtmapi.invalid/schemas/runtime/0.5.5/manifest.schema.json",
  "title": "DTMAPI Runtime 0.5.5 manifest authoring baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["Name", "Author", "Version", "Description", "UniqueID", "MinimumDTMApiVersion", "Type"],
  "properties": {
    "Name": { "type": "string", "minLength": 1 },
    "Author": { "type": "string", "minLength": 1 },
    "Version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "Description": { "type": "string", "minLength": 1 },
    "UniqueID": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*(?:\\.[A-Za-z0-9][A-Za-z0-9_-]*)+$" },
    "EntryDll": { "type": "string" },
    "EntryType": { "type": "string" },
    "MinimumDTMApiVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "MinimumGameVersion": { "type": "string" },
    "Type": { "enum": ["CodeMod", "ContentPack"] },
    "CodeModKind": { "enum": ["Strict", "Advanced"] },
    "Dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["UniqueID"],
        "properties": {
          "UniqueID": { "type": "string" },
          "MinimumVersion": { "type": "string" },
          "Required": { "type": "boolean" }
        }
      }
    },
    "UpdateKeys": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "Type": { "const": "CodeMod" } } },
      "then": { "required": ["EntryDll", "EntryType"] }
    },
    {
      "if": { "properties": { "Type": { "const": "ContentPack" } } },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["EntryDll"] },
            { "required": ["EntryType"] },
            { "required": ["CodeModKind"] }
          ]
        }
      }
    },
    {
      "if": { "required": ["CodeModKind"] },
      "then": { "properties": { "Type": { "const": "CodeMod" } } }
    }
  ]
}
