{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtmapi.invalid/schemas/author-sdk/0.1/advanced-reference-receipt.schema.json",
  "title": "DTMAPI Advanced CodeMod native-reference receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptKind",
    "referencePolicyId",
    "referencePolicyVersion",
    "referencePolicySha256",
    "uniqueId",
    "codeModKind",
    "targetFramework",
    "gameBuildId",
    "gameAssemblyRelativePath",
    "gameAssemblySha256",
    "manifestPath",
    "manifestSha256",
    "entryDllPath",
    "entryDllLength",
    "entryDllSha256",
    "harmonyOwner",
    "references"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "receiptKind": { "const": "DTMAPI.AdvancedCodeMod.ReferenceReceipt" },
    "referencePolicyId": { "type": "string", "minLength": 1 },
    "referencePolicyVersion": { "type": "integer", "minimum": 1 },
    "referencePolicySha256": { "$ref": "#/$defs/sha256" },
    "uniqueId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*(?:\\.[A-Za-z0-9][A-Za-z0-9_-]*)+$" },
    "codeModKind": { "const": "Advanced" },
    "targetFramework": { "const": "netstandard2.0" },
    "gameBuildId": { "type": "string", "pattern": "^[0-9]+$" },
    "gameAssemblyRelativePath": { "$ref": "#/$defs/relativeDllPath" },
    "gameAssemblySha256": { "$ref": "#/$defs/sha256" },
    "manifestPath": { "const": "Content/DTMAPI/manifest.json" },
    "manifestSha256": { "$ref": "#/$defs/sha256" },
    "entryDllPath": { "$ref": "#/$defs/packageEntryDllPath" },
    "entryDllLength": { "type": "integer", "minimum": 1 },
    "entryDllSha256": { "$ref": "#/$defs/sha256" },
    "harmonyOwner": { "type": "string", "pattern": "^dtmapi\\.mod\\.[a-z0-9._-]+$" },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/reference" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "relativeDllPath": {
      "type": "string",
      "pattern": "^(?:(?!\\.{1,2}(?:/|$))[^/\\\\:]+/)*(?!\\.{1,2}$)[^/\\\\:]+\\.dll$"
    },
    "packageEntryDllPath": {
      "type": "string",
      "pattern": "^Content/DTMAPI/(?!\\.{1,2}$)[^/\\\\:]+\\.dll$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gameRelativePath", "assemblyName", "length", "sha256", "copyLocal"],
      "properties": {
        "gameRelativePath": { "$ref": "#/$defs/relativeDllPath" },
        "assemblyName": { "type": "string", "minLength": 1 },
        "length": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "copyLocal": { "const": false }
      }
    }
  }
}
