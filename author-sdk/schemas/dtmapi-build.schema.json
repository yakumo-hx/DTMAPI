{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DTMAPI SDK bounded project build inputs",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "workspaceRoot": {
      "type": "string",
      "minLength": 1
    },
    "projectReferences": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "\\.csproj$"
      }
    },
    "generatedSourceFiles": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "\\.cs$"
      }
    },
    "embeddedResources": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "logicalName"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "logicalName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "contentFiles": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "targetPath"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "targetPath": {
            "type": "string",
            "pattern": "^Content/"
          }
        }
      }
    },
    "restore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "packages",
        "licenseFiles"
      ],
      "properties": {
        "lockFile": {
          "type": "string",
          "minLength": 1
        },
        "cacheDirectory": {
          "type": "string",
          "pattern": "^obj/"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "packages": {
          "type": "object",
          "minProperties": 0,
          "maxProperties": 32,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "licenseFiles": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "projectReferenceMetadata": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "enum": [
              "private-managed",
              "shared-contract"
            ]
          },
          "distribution": {
            "enum": [
              "self-authored",
              "licensed-third-party"
            ]
          },
          "licenseFiles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$comment": "Empty packages is only accepted on a parent with ProjectReference children, to share explicit sources/licenses; child PackageReference versions and lock remain owned by the child csproj. Compilation constants and XML output belong in csproj."
}
